*.gem
pkg/
/.bundle/
Gemfile.lock
# The docs site is a deployable application; its lockfile is committed.
# See docs/README.md for the full rationale.
!docs/Gemfile.lock
/coverage/
/.rspec_status
/tmp/
tmp/conformance-vectors/

# C extension compiled artefacts
*.bundle
*.so
*.o
*.dSYM/

# Generated documentation
# YARD output lives at docs/reference/api/ and is regenerated by `rake docs:generate`.
# Only the index.md stub is committed (mkdocs needs it for strict builds when
# the rake task hasn't been run); the class/module tree is gitignored.
# docs/reference/ itself stays tracked for authored canonical-reference content.
/docs/reference/api/*
!/docs/reference/api/index.md
doc/
.yardoc/
/site/

# Local data archives
data.tar.gz

# Claude Code
.claude/settings.local.json
.claude/agents/
.claude/agent-memory/
.claude/worktrees/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env

